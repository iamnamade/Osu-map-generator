{
  "name": "cursor-rhythm-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "node scripts/run-local-generator.mjs api",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generator:frontend": "vite --host 127.0.0.1",
    "generator:dev": "node scripts/run-local-generator.mjs",
    "generator:test": "node scripts/run-local-generator-tests.mjs",
    "generate:audio": "node scripts/generate-test-audio.mjs",
    "analyze:audio": "node scripts/run-map-generator.mjs analyze --audio public/audio/test-song.mp3 --output public/analysis/test-song-analysis.json",
    "generate:map:easy": "node scripts/run-map-generator.mjs generate --audio public/audio/test-song.mp3 --title \"Test Song\" --artist \"Unknown Artist\" --difficulty easy --seed 42 --output public/maps/generated/test-song-easy.json --analysis-output public/analysis/test-song-analysis.json",
    "generate:map:normal": "node scripts/run-map-generator.mjs generate --audio public/audio/test-song.mp3 --title \"Test Song\" --artist \"Unknown Artist\" --difficulty normal --seed 42 --output public/maps/generated/test-song-normal.json --analysis-output public/analysis/test-song-analysis.json",
    "generate:map:hard": "node scripts/run-map-generator.mjs generate --audio public/audio/test-song.mp3 --title \"Test Song\" --artist \"Unknown Artist\" --difficulty hard --seed 42 --output public/maps/generated/test-song-hard.json --analysis-output public/analysis/test-song-analysis.json",
    "validate:map:easy": "node scripts/run-map-validator.mjs easy",
    "validate:map:normal": "node scripts/run-map-validator.mjs normal",
    "validate:map:hard": "node scripts/run-map-validator.mjs hard",
    "validate:maps": "node scripts/run-map-validator.mjs all",
    "compare:maps": "node scripts/run-map-validator.mjs compare",
    "improve:map:easy": "node scripts/run-map-postprocessor.mjs easy",
    "improve:map:normal": "node scripts/run-map-postprocessor.mjs normal",
    "improve:map:hard": "node scripts/run-map-postprocessor.mjs hard",
    "improve:maps": "node scripts/run-map-postprocessor.mjs all",
    "compare:improvements": "node scripts/run-map-postprocessor.mjs compare",
    "validate:edited": "node scripts/run-edited-map-validator.mjs",
    "tournament:easy": "node scripts/run-map-tournament.mjs easy",
    "tournament:normal": "node scripts/run-map-tournament.mjs normal",
    "tournament:hard": "node scripts/run-map-tournament.mjs hard",
    "tournament:all": "node scripts/run-map-tournament.mjs all",
    "compare:tournaments": "node scripts/run-map-tournament.mjs compare",
    "evolution:easy": "node scripts/run-map-evolution.mjs easy",
    "evolution:normal": "node scripts/run-map-evolution.mjs normal",
    "evolution:hard": "node scripts/run-map-evolution.mjs hard",
    "evolution:all": "node scripts/run-map-evolution.mjs all",
    "compare:evolutions": "node scripts/run-map-evolution.mjs compare",
    "sections:analyze": "node scripts/run-section-pipeline.mjs analyze",
    "sections:evaluate:easy": "node scripts/run-section-pipeline.mjs evaluate easy",
    "sections:evaluate:normal": "node scripts/run-section-pipeline.mjs evaluate normal",
    "sections:evaluate:hard": "node scripts/run-section-pipeline.mjs evaluate hard",
    "hybrid:easy": "node scripts/run-section-pipeline.mjs hybrid easy",
    "hybrid:normal": "node scripts/run-section-pipeline.mjs hybrid normal",
    "hybrid:hard": "node scripts/run-section-pipeline.mjs hybrid hard",
    "hybrid:all": "node scripts/run-section-pipeline.mjs all",
    "compare:hybrids": "node scripts/run-section-pipeline.mjs compare",
    "export:osu:easy": "node scripts/run-osu-export.mjs easy",
    "export:osu:normal": "node scripts/run-osu-export.mjs normal",
    "export:osu:hard": "node scripts/run-osu-export.mjs hard",
    "export:osu:all": "node scripts/run-osu-export.mjs all",
    "package:osz": "node scripts/run-osu-export.mjs package",
    "validate:osu": "node scripts/run-osu-export.mjs validate",
    "difficulty:easy": "node scripts/run-map-difficulty.mjs easy",
    "difficulty:normal": "node scripts/run-map-difficulty.mjs normal",
    "difficulty:hard": "node scripts/run-map-difficulty.mjs hard",
    "difficulty:all": "node scripts/run-map-difficulty.mjs all"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "lamejs": "^1.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
